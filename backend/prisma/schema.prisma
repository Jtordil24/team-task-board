// Prisma schema for the Team Task Board
// Two related entities: User (1) -> Task (many), via Task.assigneeId.
// A Task may be unassigned (assigneeId is nullable) so creating a task never
// blocks on picking an assignee first.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  createdAt DateTime @default(now())

  tasks Task[]

  @@map("users")
}

model Task {
  id          String   @id @default(uuid())
  title       String
  description String?
  // SQLite has no native enum type, so status is stored as a plain string.
  // Allowed values ("todo" | "in_progress" | "done") are enforced at the
  // application layer — see src/tasks/task-status.ts and the DTOs' @IsEnum.
  status      String   @default("todo")

  assigneeId String?
  assignee   User?   @relation(fields: [assigneeId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([assigneeId])
  @@map("tasks")
}
